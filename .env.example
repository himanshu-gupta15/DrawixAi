# --- Required infrastructure (docker compose up -d provides both) ---
DATABASE_URL="postgresql://dravix:dravix@localhost:5433/dravix?schema=public"
VECTOR_DATABASE_URL="http://localhost:6333"

# --- Optional: Groq LLM (takes precedence over Anthropic when set). Never commit a real key. ---
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Optional: Claude LLM (Anthropic). Without it the app uses deterministic,
# retrieval-only answer composition (no generative text). ---
LLM_API_KEY=""
LLM_MODEL="claude-opus-5-5"

# --- Optional: escalation webhook (Q1). If empty, escalations are logged to the DB only. ---
ESCALATION_WEBHOOK_URL=""

# --- Local models (downloaded once from Hugging Face into ./.models, no key needed) ---
EMBEDDING_MODEL="Xenova/multilingual-e5-small"
ASR_MODEL="Xenova/whisper-base"

PORT=3100
